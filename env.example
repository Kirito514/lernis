# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunft

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_me

# Encryption Key (32 bytes in hex)
ENCRYPTION_KEY_32B=your_32_byte_encryption_key_in_hex_here

# IPFS (Pinata)
PINATA_JWT=your_pinata_jwt_here

# Biconomy (Gasless Transactions)
BICONOMY_API_KEY=your_biconomy_api_key_here
BICONOMY_API_ID=your_biconomy_api_id_here
GASLESS_MODE=mock

# Blockchain
MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_PROJECT_ID
PRIVATE_KEY=0x_your_private_key_here
CONTRACT_ADDRESS=

# Email
EMAIL_FROM=noreply@edunft.io
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
NEXT_PUBLIC_MUMBAI_RPC=https://polygon-mumbai.infura.io/v3/YOUR_PROJECT_ID
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Optional: Polygonscan API Key for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
